rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Users collection rules
    // Requirement 9.5: Restrict users to their own data
    match /users/{userId} {
      // Users can read their own document (including subscription fields)
      allow read: if isOwner(userId);
      
      // Users can create their own document (during signup)
      allow create: if isOwner(userId);
      
      // Users can update their own document, but not subscription fields
      // Subscription fields can only be updated by Cloud Functions (backend)
      allow update: if isOwner(userId) &&
                     // Prevent users from modifying subscription-related fields
                     !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                       'subscriptionPlan',
                       'subscriptionStatus',
                       'stripeCustomerId',
                       'stripeSubscriptionId',
                       'currentPeriodStart',
                       'currentPeriodEnd',
                       'videoQuota',
                       'videosUsedThisMonth'
                     ]);
      
      // No one can delete user documents
      allow delete: if false;
    }
    
    // VideoJobs collection rules
    // Requirement 9.5: Restrict users to their own data
    // Requirement 3.2: Allow authenticated users to create jobs
    match /videoJobs/{jobId} {
      // Users can only read their own jobs
      // Requirement 9.5: Allow users to read only their own jobs
      allow read: if isAuthenticated() && 
                     resource.data.userId == request.auth.uid;
      
      // Authenticated users can create jobs
      // Requirement 3.2: Allow authenticated users to create jobs
      allow create: if isAuthenticated() && 
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.prompt is string &&
                       request.resource.data.prompt.size() > 0;
      
      // Prevent direct job status updates from frontend
      // Requirement 9.5: Prevent direct job status updates from frontend
      // Only Cloud Functions (server-side) should update job status
      // Users cannot update their jobs directly
      allow update: if false;
      
      // Users cannot delete jobs
      allow delete: if false;
    }
    
    // Metrics collection rules
    // Allow users to read and create their own metrics
    // Requirement 9.5: Restrict users to their own data
    match /metrics/{metricId} {
      // Users can read metrics where userId matches their own uid
      // This allows queries filtering by userId == request.auth.uid
      allow read: if isAuthenticated() && 
                     resource.data.userId == request.auth.uid;
      
      // Users can create metrics for tracking
      // Ensure userId matches the authenticated user (required for security)
      allow create: if isAuthenticated() && 
                       request.resource.data.userId == request.auth.uid;
      
      // Users cannot update or delete metrics
      allow update, delete: if false;
    }
    
    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
