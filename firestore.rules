rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Users collection rules
    // Requirement 9.5: Restrict users to their own data
    match /users/{userId} {
      // Users can read their own document
      allow read: if isOwner(userId);
      
      // Users can create their own document (during signup)
      allow create: if isOwner(userId);
      
      // Users can update their own document
      allow update: if isOwner(userId);
      
      // No one can delete user documents
      allow delete: if false;
    }
    
    // VideoJobs collection rules
    // Requirement 9.5: Restrict users to their own data
    // Requirement 3.2: Allow authenticated users to create jobs
    match /videoJobs/{jobId} {
      // Users can only read their own jobs
      // Requirement 9.5: Allow users to read only their own jobs
      allow read: if isAuthenticated() && 
                     resource.data.userId == request.auth.uid;
      
      // Authenticated users can create jobs
      // Requirement 3.2: Allow authenticated users to create jobs
      allow create: if isAuthenticated() && 
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.prompt is string &&
                       request.resource.data.prompt.size() > 0;
      
      // Prevent direct job status updates from frontend
      // Requirement 9.5: Prevent direct job status updates from frontend
      // Only Cloud Functions (server-side) should update job status
      // Users cannot update their jobs directly
      allow update: if false;
      
      // Users cannot delete jobs
      allow delete: if false;
    }
    
    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
